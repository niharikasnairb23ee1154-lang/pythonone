# Student marks in five subjects
marks = np.array([
    [85, 78, 92, 88, 90],
    [72, 80, 75, 79, 85],
    [90, 95, 88, 92, 94],
    [60, 65, 70, 68, 72]
])

print("Student Marks:")
print(marks)

# Total marks of each student
total = np.sum(marks, axis=1)

# Average marks of each student
average = np.mean(marks, axis=1)

print("\nTotal Marks:")
print(total)

print("\nAverage Marks:")
print(average)

# Highest and lowest marks
print("\nHighest Mark:", np.max(marks))
print("Lowest Mark:", np.min(marks))

# Students with average above 80
high_performers = average > 80

print("\nStudents with average above 80:")
print(average[high_performers])

