# -----------------------------
# 1. IMPORT LIBRARIES
# -----------------------------

import pandas as pd
import numpy as np

import matplotlib.pyplot as plt
import seaborn as sns

from google.colab import files

from sklearn.model_selection import train_test_split

from sklearn.compose import ColumnTransformer

from sklearn.pipeline import Pipeline

from sklearn.preprocessing import (
    OneHotEncoder,
    StandardScaler
)

from sklearn.impute import SimpleImputer

from sklearn.linear_model import (
    LinearRegression,
    LogisticRegression
)

from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score,
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

sns.set_style("whitegrid")

pd.set_option(
    "display.max_columns",
    None
)


# -----------------------------
# 2. LOAD DATASET
# -----------------------------

uploaded = files.upload()

file_name = list(uploaded.keys())[0]

df = pd.read_csv(file_name)

print("Dataset loaded successfully!")

print("Shape:", df.shape)

display(df.head())


# -----------------------------
# 3. DATASET INSPECTION
# -----------------------------

print("\nDataset Information:")

df.info()


print("\nStatistical Summary:")

display(
    df.describe(include="all").T
)


print("\nMissing Values:")

display(
    df.isnull().sum()
)


print(
    "\nDuplicate Records:",
    df.duplicated().sum()
)


# Remove duplicate records

df = df.drop_duplicates()

print(
    "Shape after removing duplicates:",
    df.shape
)


# -----------------------------
# 4. NUMERICAL AND CATEGORICAL VARIABLES
# -----------------------------

numerical_cols = df.select_dtypes(
    include=np.number
).columns.tolist()

categorical_cols = df.select_dtypes(
    include="object"
).columns.tolist()

print("\nNumerical Variables:")

print(numerical_cols)


print("\nCategorical Variables:")

print(categorical_cols)


# -----------------------------
# 5. EXAM SCORE DISTRIBUTION
# -----------------------------

plt.figure(figsize=(8, 5))

sns.histplot(
    df["exam_score"],
    bins=20,
    kde=True
)

plt.title("Distribution of Exam Scores")
plt.xlabel("Exam Score")
plt.ylabel("Frequency")

plt.show()


# -----------------------------
# 6. BOXPLOT OF EXAM SCORE
# -----------------------------

plt.figure(figsize=(8, 4))

sns.boxplot(
    x=df["exam_score"]
)

plt.title("Boxplot of Exam Scores")

plt.show()


# -----------------------------
# 7. CORRELATION HEATMAP
# -----------------------------

correlation = df.select_dtypes(
    include=np.number
).corr()

plt.figure(figsize=(12, 9))

sns.heatmap(
    correlation,
    annot=True,
    fmt=".2f",
    cmap="coolwarm"
)

plt.title("Correlation Heatmap")

plt.show()


# -----------------------------
# 8. CORRELATION WITH EXAM SCORE
# -----------------------------

exam_correlations = (
    correlation["exam_score"]
    .sort_values(
        ascending=False
    )
)

print(
    "\nCorrelation with Exam Score:"
)

display(
    exam_correlations
)


# -----------------------------
# 9. STUDY HOURS VS EXAM SCORE
# -----------------------------

if "study_hours_per_day" in df.columns:

    plt.figure(figsize=(7, 5))

    sns.scatterplot(
        data=df,
        x="study_hours_per_day",
        y="exam_score"
    )

    plt.title(
        "Study Hours vs Exam Score"
    )

    plt.show()


# -----------------------------
# 10. ATTENDANCE VS EXAM SCORE
# -----------------------------

if "attendance_percentage" in df.columns:

    plt.figure(figsize=(7, 5))

    sns.scatterplot(
        data=df,
        x="attendance_percentage",
        y="exam_score"
    )

    plt.title(
        "Attendance vs Exam Score"
    )

    plt.show()


# -----------------------------
# 11. SLEEP VS EXAM SCORE
# -----------------------------

if "sleep_hours" in df.columns:

    plt.figure(figsize=(7, 5))

    sns.scatterplot(
        data=df,
        x="sleep_hours",
        y="exam_score"
    )

    plt.title(
        "Sleep Hours vs Exam Score"
    )

    plt.show()


# -----------------------------
# 12. SOCIAL MEDIA VS EXAM SCORE
# -----------------------------

if "social_media_hours" in df.columns:

    plt.figure(figsize=(7, 5))

    sns.scatterplot(
        data=df,
        x="social_media_hours",
        y="exam_score"
    )

    plt.title(
        "Social Media Hours vs Exam Score"
    )

    plt.show()


# -----------------------------
# 13. SELECT FEATURES
# -----------------------------

possible_features = [
    "study_hours_per_day",
    "attendance_percentage",
    "sleep_hours",
    "social_media_hours",
    "netflix_hours",
    "exercise_frequency",
    "mental_health_rating"
]

# Use only features that exist
features = [
    col for col in possible_features
    if col in df.columns
]

print("\nFeatures selected:")

print(features)


# -----------------------------
# 14. DEFINE REGRESSION TARGET
# -----------------------------

X = df[features]

y = df["exam_score"]


# -----------------------------
# 15. IDENTIFY FEATURE TYPES
# -----------------------------

numeric_features = X.select_dtypes(
    include=np.number
).columns.tolist()

categorical_features = X.select_dtypes(
    include="object"
).columns.tolist()

print(
    "\nNumerical Features:",
    numeric_features
)

print(
    "\nCategorical Features:",
    categorical_features
)


# -----------------------------
# 16. DATA PREPROCESSING
# -----------------------------

numeric_transformer = Pipeline(
    steps=[
        (
            "imputer",
            SimpleImputer(
                strategy="median"
            )
        ),

        (
            "scaler",
            StandardScaler()
        )
    ]
)


categorical_transformer = Pipeline(
    steps=[
        (
            "imputer",
            SimpleImputer(
                strategy="most_frequent"
            )
        ),

        (
            "onehot",
            OneHotEncoder(
                handle_unknown="ignore"
            )
        )
    ]
)


preprocessor = ColumnTransformer(
    transformers=[
        (
            "num",
            numeric_transformer,
            numeric_features
        ),

        (
            "cat",
            categorical_transformer,
            categorical_features
        )
    ]
)


# -----------------------------
# 17. TRAIN-TEST SPLIT
# -----------------------------

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

print(
    "\nTraining samples:",
    len(X_train)
)

print(
    "Testing samples:",
    len(X_test)
)


# ============================================================
# REGRESSION
# ============================================================


# -----------------------------
# 18. LINEAR REGRESSION MODEL
# -----------------------------

regression_model = Pipeline(
    steps=[
        (
            "preprocessor",
            preprocessor
        ),

        (
            "model",
            LinearRegression()
        )
    ]
)


regression_model.fit(
    X_train,
    y_train
)


# -----------------------------
# 19. REGRESSION PREDICTIONS
# -----------------------------

y_train_pred = (
    regression_model.predict(
        X_train
    )
)

y_test_pred = (
    regression_model.predict(
        X_test
    )
)


# -----------------------------
# 20. REGRESSION EVALUATION
# -----------------------------

train_mae = mean_absolute_error(
    y_train,
    y_train_pred
)

test_mae = mean_absolute_error(
    y_test,
    y_test_pred
)


train_mse = mean_squared_error(
    y_train,
    y_train_pred
)

test_mse = mean_squared_error(
    y_test,
    y_test_pred
)


train_rmse = np.sqrt(
    train_mse
)

test_rmse = np.sqrt(
    test_mse
)


train_r2 = r2_score(
    y_train,
    y_train_pred
)

test_r2 = r2_score(
    y_test,
    y_test_pred
)


regression_results = pd.DataFrame({

    "Metric": [
        "MAE",
        "MSE",
        "RMSE",
        "R2 Score"
    ],

    "Training": [
        train_mae,
        train_mse,
        train_rmse,
        train_r2
    ],

    "Testing": [
        test_mae,
        test_mse,
        test_rmse,
        test_r2
    ]

})


print("\nREGRESSION RESULTS")

display(
    regression_results.round(4)
)


# -----------------------------
# 21. ACTUAL VS PREDICTED
# -----------------------------

plt.figure(figsize=(7, 6))

sns.scatterplot(
    x=y_test,
    y=y_test_pred
)

plt.xlabel(
    "Actual Exam Score"
)

plt.ylabel(
    "Predicted Exam Score"
)

plt.title(
    "Actual vs Predicted Exam Scores"
)

plt.show()


# ============================================================
# CLASSIFICATION
# ============================================================


# -----------------------------
# 22. CREATE PASS/FAIL TARGET
# -----------------------------

df["pass_fail"] = np.where(
    df["exam_score"] >= 50,
    1,
    0
)


print(
    "\nPass/Fail Distribution:"
)

display(
    df["pass_fail"].value_counts()
)


# -----------------------------
# 23. CLASSIFICATION DATA
# -----------------------------

X_class = df[features]

y_class = df["pass_fail"]


# -----------------------------
# 24. TRAIN-TEST SPLIT
# -----------------------------

X_train_c, X_test_c, y_train_c, y_test_c = train_test_split(
    X_class,
    y_class,
    test_size=0.20,
    random_state=42,
    stratify=y_class
)


# -----------------------------
# 25. LOGISTIC REGRESSION
# -----------------------------

classification_model = Pipeline(
    steps=[
        (
            "preprocessor",
            preprocessor
        ),

        (
            "model",
            LogisticRegression(
                max_iter=1000
            )
        )
    ]
)


classification_model.fit(
    X_train_c,
    y_train_c
)


# -----------------------------
# 26. CLASSIFICATION PREDICTIONS
# -----------------------------

y_train_class_pred = (
    classification_model.predict(
        X_train_c
    )
)

y_test_class_pred = (
    classification_model.predict(
        X_test_c
    )
)


# -----------------------------
# 27. CLASSIFICATION METRICS
# -----------------------------

train_accuracy = accuracy_score(
    y_train_c,
    y_train_class_pred
)

test_accuracy = accuracy_score(
    y_test_c,
    y_test_class_pred
)


train_precision = precision_score(
    y_train_c,
    y_train_class_pred,
    zero_division=0
)

test_precision = precision_score(
    y_test_c,
    y_test_class_pred,
    zero_division=0
)


train_recall = recall_score(
    y_train_c,
    y_train_class_pred,
    zero_division=0
)

test_recall = recall_score(
    y_test_c,
    y_test_class_pred,
    zero_division=0
)


train_f1 = f1_score(
    y_train_c,
    y_train_class_pred,
    zero_division=0
)

test_f1 = f1_score(
    y_test_c,
    y_test_class_pred,
    zero_division=0
)


classification_results = pd.DataFrame({

    "Metric": [
        "Accuracy",
        "Precision",
        "Recall",
        "F1 Score"
    ],

    "Training": [
        train_accuracy,
        train_precision,
        train_recall,
        train_f1
    ],

    "Testing": [
        test_accuracy,
        test_precision,
        test_recall,
        test_f1
    ]

})


print("\nCLASSIFICATION RESULTS")

display(
    classification_results.round(4)
)


# -----------------------------
# 28. CONFUSION MATRIX
# -----------------------------

cm = confusion_matrix(
    y_test_c,
    y_test_class_pred
)


plt.figure(figsize=(6, 5))

sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Blues",
    xticklabels=[
        "Fail",
        "Pass"
    ],
    yticklabels=[
        "Fail",
        "Pass"
    ]
)

plt.xlabel(
    "Predicted"
)

plt.ylabel(
    "Actual"
)

plt.title(
    "Confusion Matrix"
)

plt.show()


# -----------------------------
# 29. CLASSIFICATION REPORT
# -----------------------------

print(
    classification_report(
        y_test_c,
        y_test_class_pred,
        target_names=[
            "Fail",
            "Pass"
        ],
        zero_division=0
    )
)


# -----------------------------
# 30. OVERFITTING / UNDERFITTING
# -----------------------------

print("\nMODEL GENERALIZATION")

print(
    "Regression Training R2:",
    round(train_r2, 4)
)

print(
    "Regression Testing R2:",
    round(test_r2, 4)
)

print(
    "\nClassification Training Accuracy:",
    round(train_accuracy, 4)
)

print(
    "Classification Testing Accuracy:",
    round(test_accuracy, 4)
)


# Automatically provide basic interpretation

r2_gap = abs(
    train_r2 -
    test_r2
)

accuracy_gap = abs(
    train_accuracy -
    test_accuracy
)


print("\nINTERPRETATION")

if r2_gap > 0.15:
    print(
        "Regression shows a relatively large "
        "training-testing performance gap, "
        "which may indicate overfitting."
    )
else:
    print(
        "Regression training and testing "
        "performance are reasonably close."
    )


if accuracy_gap > 0.15:
    print(
        "Classification shows a relatively large "
        "training-testing performance gap, "
        "which may indicate overfitting."
    )
else:
    print(
        "Classification training and testing "
        "performance are reasonably close."
    )


