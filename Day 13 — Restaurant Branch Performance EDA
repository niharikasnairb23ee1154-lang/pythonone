# DAY 13 - RESTAURANT BRANCH PERFORMANCE EDA

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# ---------------------------------------------------
# 1. LOAD DATASET
# ---------------------------------------------------

df = pd.read_csv("restaurant_branch_performance.csv")

print("First 5 rows:")
print(df.head())

print("\nDataset Shape:")
print(df.shape)

print("\nDataset Information:")
print(df.info())

# ---------------------------------------------------
# 2. DATA QUALITY CHECK
# ---------------------------------------------------

print("\nMissing Values:")
print(df.isnull().sum())

print("\nDuplicate Records:")
print(df.duplicated().sum())

print("\nData Types:")
print(df.dtypes)

# Remove duplicate records
df = df.drop_duplicates()

# ---------------------------------------------------
# 3. DESCRIPTIVE STATISTICS
# ---------------------------------------------------

print("\nDescriptive Statistics:")
print(df.describe(include="all"))

# Numerical summary
print("\nNumerical Summary:")
print(df.describe())

# ---------------------------------------------------
# 4. IDENTIFY NUMERICAL AND CATEGORICAL VARIABLES
# ---------------------------------------------------

numerical_columns = df.select_dtypes(
    include=np.number
).columns.tolist()

categorical_columns = df.select_dtypes(
    include=["object"]
).columns.tolist()

print("\nNumerical Columns:")
print(numerical_columns)

print("\nCategorical Columns:")
print(categorical_columns)

# ---------------------------------------------------
# 5. DISTRIBUTION ANALYSIS
# ---------------------------------------------------

for column in numerical_columns:
    plt.figure(figsize=(8, 5))
    sns.histplot(df[column], kde=True)
    plt.title("Distribution of " + column)
    plt.xlabel(column)
    plt.ylabel("Frequency")
    plt.tight_layout()
    plt.show()

# ---------------------------------------------------
# 6. BOX PLOTS FOR NUMERICAL VARIABLES
# ---------------------------------------------------

for column in numerical_columns:
    plt.figure(figsize=(8, 5))
    sns.boxplot(x=df[column])
    plt.title("Box Plot of " + column)
    plt.xlabel(column)
    plt.tight_layout()
    plt.show()

# ---------------------------------------------------
# 7. ANALYZE CATEGORICAL VARIABLES
# ---------------------------------------------------

for column in categorical_columns:
    print("\nValue Counts for", column)
    print(df[column].value_counts())

# ---------------------------------------------------
# 8. PERFORMANCE BY BRANCH
# ---------------------------------------------------

# Change column names if necessary according to your dataset
if "Branch" in df.columns:
    branch_performance = df.groupby("Branch").agg({
        "Customers": "sum",
        "Revenue": "sum",
        "Profit": "sum"
    }).sort_values("Revenue", ascending=False)

    print("\nPerformance by Branch:")
    print(branch_performance)

# ---------------------------------------------------
# 9. PERFORMANCE BY REGION
# ---------------------------------------------------

if "Region" in df.columns:
    region_performance = df.groupby("Region").agg({
        "Customers": "sum",
        "Revenue": "sum",
        "Profit": "sum"
    }).sort_values("Revenue", ascending=False)

    print("\nPerformance by Region:")
    print(region_performance)

# ---------------------------------------------------
# 10. PERFORMANCE BY STORE TYPE
# ---------------------------------------------------

if "Store_Type" in df.columns:
    store_type_performance = df.groupby("Store_Type").agg({
        "Customers": "mean",
        "Revenue": "mean",
        "Profit": "mean",
        "Customer_Rating": "mean"
    }).sort_values("Revenue", ascending=False)

    print("\nPerformance by Store Type:")
    print(store_type_performance)

# ---------------------------------------------------
# 11. CUSTOMERS VS REVENUE
# ---------------------------------------------------

if "Customers" in df.columns and "Revenue" in df.columns:
    plt.figure(figsize=(8, 5))

    sns.scatterplot(
        data=df,
        x="Customers",
        y="Revenue"
    )

    plt.title("Customers vs Revenue")
    plt.xlabel("Number of Customers")
    plt.ylabel("Revenue")
    plt.tight_layout()
    plt.show()

# ---------------------------------------------------
# 12. MARKETING SPEND VS REVENUE
# ---------------------------------------------------

if "Marketing_Spend" in df.columns and "Revenue" in df.columns:
    plt.figure(figsize=(8, 5))

    sns.scatterplot(
        data=df,
        x="Marketing_Spend",
        y="Revenue"
    )

    plt.title("Marketing Spend vs Revenue")
    plt.xlabel("Marketing Spend")
    plt.ylabel("Revenue")
    plt.tight_layout()
    plt.show()

# ---------------------------------------------------
# 13. DELIVERY TIME VS CUSTOMER RATING
# ---------------------------------------------------

if "Delivery_Time" in df.columns and "Customer_Rating" in df.columns:
    plt.figure(figsize=(8, 5))

    sns.scatterplot(
        data=df,
        x="Delivery_Time",
        y="Customer_Rating"
    )

    plt.title("Delivery Time vs Customer Rating")
    plt.xlabel("Delivery Time")
    plt.ylabel("Customer Rating")
    plt.tight_layout()
    plt.show()

# ---------------------------------------------------
# 14. CORRELATION MATRIX
# ---------------------------------------------------

correlation_matrix = df[numerical_columns].corr()

print("\nCorrelation Matrix:")
print(correlation_matrix)

plt.figure(figsize=(12, 8))

sns.heatmap(
    correlation_matrix,
    annot=True,
    cmap="coolwarm",
    fmt=".2f"
)

plt.title("Correlation Matrix of Numerical Variables")
plt.tight_layout()
plt.show()

# ---------------------------------------------------
# 15. STRONG CORRELATIONS
# ---------------------------------------------------

print("\nStrong Correlations:")

for i in range(len(correlation_matrix.columns)):
    for j in range(i + 1, len(correlation_matrix.columns)):

        correlation = correlation_matrix.iloc[i, j]

        if abs(correlation) >= 0.7:
            print(
                correlation_matrix.columns[i],
                "and",
                correlation_matrix.columns[j],
                ":",
                round(correlation, 2)
            )

# ---------------------------------------------------
# 16. TOP PERFORMING BRANCH
# ---------------------------------------------------

if "Branch" in df.columns and "Revenue" in df.columns:

    branch_revenue = df.groupby("Branch")["Revenue"].sum()

    top_branch = branch_revenue.idxmax()
    top_revenue = branch_revenue.max()

    print("\nTop Performing Branch:")
    print(top_branch)

    print("Revenue:", top_revenue)

# ---------------------------------------------------
# 17. MOST PROFITABLE BRANCH
# ---------------------------------------------------

if "Branch" in df.columns and "Profit" in df.columns:

    branch_profit = df.groupby("Branch")["Profit"].sum()

    profitable_branch = branch_profit.idxmax()
    highest_profit = branch_profit.max()

    print("\nMost Profitable Branch:")
    print(profitable_branch)

    print("Profit:", highest_profit)

# ---------------------------------------------------
# 18. FINAL DATASET CHECK
# ---------------------------------------------------

print("\nFinal Dataset Shape:", df.shape)

print("\nMissing Values:")
print(df.isnull().sum())

print("\nEDA completed successfully!")
